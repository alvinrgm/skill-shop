# ad-loop environment. Copy to .env (same folder) and fill in. Never commit .env.

# REQUIRED: powers all image generation and every vision instrument.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: where client folders, loop-state and the corpus live (default ~/ad-loop-work)
# AD_LOOP_HOME=~/ad-loop-work
# AD_LOOP_NORTH_STARS=~/ad-loop-work/north-stars

# Optional: vision-judge model (default gemini-3.1-pro-preview)
# AD_LOOP_VISION_MODEL=

# Optional spend guard (defaults: 15 plates per batch, 1K drafts, 4K winner only)
# AD_LOOP_VOLUME_CAP=15
# AD_LOOP_VOLUME_SIZE=1K
# AD_LOOP_WINNER_SIZE=4K

# Optional overrides
# AD_LOOP_DESIGN_LAWS=
# AD_LOOP_TASTE_BRIEF=
# AD_LOOP_GEN_IMAGE=
# AD_LOOP_AI_ISMS=
