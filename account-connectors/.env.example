# account-connectors: secrets template.
# Copy to .env, fill in, then push to Cloudflare with:  bash scripts/push-secrets.sh
# (each line becomes `npx wrangler secret put NAME`). NEVER commit the real .env.
# The live values live in Cloudflare, not in this file; .env is only your local
# staging copy so doctor.sh and scripts/check-vendors.mjs can test them first.
#
# Only the first block is required. Every vendor block is optional: a vendor's
# tools appear in Claude only when its secrets are set.

# ---------------------------------------------------------------------------
# REQUIRED: Google sign-in (this is how users authenticate to YOUR server)
# YOUR OWN Google Cloud project > APIs & Services > Credentials > OAuth client ID
# > Web application. Authorized redirect URI: <WORKER_BASE>/callback
# Walkthrough: SETUP.md, step 4.  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32-byte hex string that encrypts the approval cookie.
# Leave blank: scripts/push-secrets.sh generates one for you.
COOKIE_ENCRYPTION_KEY=

# REQUIRED: who may sign in. Set at least one (comma-separated, no spaces needed).
# Empty = nobody can sign in (the server fails closed).
ALLOWED_EMAILS=you@example.com
# Every Google account in these domains may sign in (Google Workspace domains).
ALLOWED_DOMAINS=

# RECOMMENDED: the public URL of your deployment, no trailing slash. Printed by
# `npx wrangler deploy`. Needed for Meta writes, Meta uploads and Shopify install links.
WORKER_BASE=https://account-connectors.your-subdomain.workers.dev

# OPTIONAL: one admin email. The admin can use the raw google_api passthrough and
# mint approval slips that other users may redeem. Leave blank for no admin.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# OPTIONAL: Meta reads (meta_get). A System User token from YOUR Business Manager,
# permission ads_read, with your ad account(s) assigned to the System User.
# https://business.facebook.com/settings/system-users   Walkthrough: SETUP.md, "Meta".
META_ACCESS_TOKEN=

# OPTIONAL: Meta writes (meta_connect, meta_mutate, meta_upload_*, meta_delete).
# A Meta Business app with Facebook Login for Business; redirect URI
# <WORKER_BASE>/meta/callback.  https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL: Google Ads reads (gads_search).
# Developer token: Google Ads manager account > Tools > API Center.
#   https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=
# A "Desktop app" OAuth client in YOUR OWN Google Cloud project (Google Ads API enabled).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Minted by: node scripts/mint-google-ads-refresh-token.mjs --write-env
GOOGLE_ADS_REFRESH_TOKEN=
# Your manager (MCC) account id, digits only, if you reach accounts through one.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# OPTIONAL: Shopify reads (shopify_query). Two ways, use either or both:
# (a) An app from the Shopify Dev Dashboard; then install it per store at
#     <WORKER_BASE>/shopify/install?store=<subdomain>.  https://dev.shopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# (b) Admin API tokens you already have, as JSON: {"your-store": "shpat_xxx"}
SHOPIFY_TOKENS=

# ---------------------------------------------------------------------------
# OPTIONAL: Klaviyo reads (klaviyo_get). A private API key with READ-ONLY scopes.
# Klaviyo > Settings > API keys > Create private API key.
#   https://www.klaviyo.com/settings/account/api-keys
KLAVIYO_API_KEY=

# ---------------------------------------------------------------------------
# LOCAL TEST HELPERS: used only by scripts/check-vendors.mjs. Never pushed to
# Cloudflare (scripts/push-secrets.sh skips CHECK_* keys). `npm run dev` does bind
# them locally like every .env key; the server ignores them.
CHECK_META_AD_ACCOUNT=
CHECK_GOOGLE_ADS_CUSTOMER_ID=
CHECK_SHOPIFY_STORE=
