# ad-library: environment template
# Copy to `.env` (next to SKILL.md) and fill in. NEVER commit the real .env.

# REQUIRED. Photo plates (Nano Banana image models) and the print gate (Gemini vision).
# Get a key: https://aistudio.google.com/apikey   (pay as you go on your own Google project:
# roughly $0.13 per 1K-2K plate, $0.24 per 4K plate)
GEMINI_API_KEY=

# OPTIONAL. learn.py: read-only pull of your ads with spend onto the angle tree.
# Your OWN token with ads_read: https://developers.facebook.com/tools/explorer/
# (or a System User token from Meta Business Settings for one that does not expire)
META_ACCESS_TOKEN=
# Your ad account number, with or without act_ (Ads Manager -> account menu)
META_AD_ACCOUNT_ID=
# META_GRAPH_VERSION=v24.0

# OPTIONAL. figma_comments.py: read and answer reviewer comments on the brand's file.
# Figma -> Settings -> Security -> Personal access tokens (File content read, Comments write)
# https://developers.figma.com/docs/rest-api/authentication/
FIGMA_TOKEN=
# FIGMA_REPLY_PREFIX="claude: "

# --- optional overrides ---
# Where brand folders live (default: ~/ad-library)
# AD_LIBRARY_HOME=
# Model ids, only if Google renames them (see python3 scripts/probe_gemini.py)
# AD_LIBRARY_VISION_MODEL=gemini-3.1-pro-preview
# AD_LIBRARY_IMAGE_MODEL_NB2=gemini-3.1-flash-image
# AD_LIBRARY_IMAGE_MODEL_PRO=gemini-3-pro-image-preview

# The Figma MCP is NOT a key: connect it to Claude Code with your own Figma account (SETUP.md).
