# adlib-creative-intel — environment template
# Copy to `.env` and fill in. NEVER commit the real .env.
#
# Everything here is OPTIONAL. Harvesting a page's ads, downloading the videos,
# and generating the longevity report all work with no credentials whatsoever —
# the Ad Library is a public page.

# Per-second creative analysis (script, on-screen text, hook, pacing).
# Only needed if you want the creative teardown on top of the longevity report.
# Get a key: https://aistudio.google.com/apikey   (free tier is enough)
GEMINI_API_KEY=

# --- optional path overrides ---
# Where creatives, sidecars, and the ledger live (default: <package>/data)
# ADLIB_DATA=
# Where reports are written (default: <package>/outputs)
# ADLIB_OUTPUT=
