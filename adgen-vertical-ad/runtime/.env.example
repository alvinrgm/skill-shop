# adgen — copy to .env at your ADGEN_HOME and fill in YOUR keys.
# This file ships placeholders only; never commit a real .env.

# Google Gemini "Nano Banana Pro" — ALL still images (refs, contact sheets, start-frames).
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ElevenLabs — character voices (lip-synced in seedance). Creator tier (~$22/mo) for v3.
# Get a key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- legacy / unused by the current pipeline; leave blank ---
