# AI Account Manager — environment config
# Copy to runtime/.env and fill in.  cp runtime/.env.example runtime/.env
# NOTHING here is committed (.gitignore blocks .env). Generated from dependencies.yml.

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Your self-deployed Google Apps Script bridge (see bridge/SETUP.md).
# BRIDGE_URL is the web-app /exec URL you get on deploy; BRIDGE_SECRET is the
# secret const you set in Code.gs. Powers ALL Slides/Docs/Sheets output.
BRIDGE_URL=
BRIDGE_SECRET=

# Slack incoming webhook — the only outbound channel; DMs you the BLUF to review.
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK=

# ── OPTIONAL: data sources (wire up only what you use) ───────────────────────
# Google Ads API (account-ops, serving checks, ad-spend-monitor Google spend)
# https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=        # your manager (MCC) id, digits only, no dashes

# Meta Marketing API (ad-spend-monitor Meta daily spend)
# https://developers.facebook.com/docs/marketing-apis/get-started
META_ACCESS_TOKEN=                    # long-lived system-user token, ads_read scope

# Triple Whale (blended / NC-ROAS attribution; falls back gracefully if absent)
# https://developers.triplewhale.com
TRIPLEWHALE_API_KEY=

# Gemini — creative-intel per-second video CV  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ── OPTIONAL: targeting overrides (usually set per-client in account.md) ─────
# DECK_PID=                           # target Slides deck id for the reporting prepend
# LOGO_URL=                           # your logo image url for deck headers
# AM_ROSTER_DIR=                      # override the default runtime/clients roster location
# AM_GOOGLE_CLIENTS=                  # comma-separated slugs to limit serving checks to
