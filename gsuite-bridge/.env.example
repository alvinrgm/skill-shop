# gsuite-bridge — copy this to `.env` and fill in your two values.
# Both come from deploying apps-script/Code.gs as a Web App (see SETUP.md).
# NEVER commit the real .env — only this .example ships.

# The Web App /exec URL from your deployment.
GSUITE_BRIDGE_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID/exec

# The shared secret. Invent a long random string and put the SAME value in the
# SECRET const at the top of Code.gs. Generate one with:
#   python3 -c "import secrets; print('gsb-'+secrets.token_hex(16))"
GSUITE_BRIDGE_SECRET=gsb-REPLACE_WITH_A_LONG_RANDOM_STRING
